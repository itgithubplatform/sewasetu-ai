# Required: replace with a unique deployment password before starting the portal.
ADMIN_PASSWORD=change-me-before-deploying
ADMIN_USERNAME=admin

# Set DATABASE_URL to the managed Postgres connection string when deploying
# outside Docker Compose. Keep the connection string secret.
# DATABASE_URL=

# Local defaults. Production must use HTTPS and the externally reachable URLs.
PUBLIC_BASE_URL=http://localhost:8000
CITIZEN_RESOURCE_URL=http://localhost:8001/mcp
OFFICER_RESOURCE_URL=http://localhost:8002/mcp
SMS_GATEWAY_URL=http://smsgw:8025

# Agent tools are enabled for Sonari by default.
MCP_ENABLED_BLOCKS=Sonari